{
  "name": "@item-enonic-types/lib-blocks",
  "description": "Item Blocks",
  "version": "0.6.0",
  "homepage": "https://github.com/ItemConsulting/lib-xp-item-blocks",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/site/mixins/**/*.d.ts",
    "dist/*.css",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-item-blocks.git"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:assets": "node tsup/build.js src/main/resources/assets build/resources/main/assets",
    "build:server": "node tsup/build.js src/main/resources build/resources/main",
    "build:postcss": "npx postcss src/main/resources/assets/styles/blocks-all.css -m -d build/resources/main/assets --base src/main/resources/assets --ext min.css",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint npm:check:styles",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:assets": "node tsup/check.js src/main/resources/assets",
    "check:types:server": "node tsup/check.js src/main/resources src/main/resources/assets",
    "check:types:storybook": "node tsup/check.js .storybook",
    "check:styles": "stylelint \"src/main/resources/**/*.css\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "stylelint": "stylelint --fix \"src/main/resources/**/*.css\"",
    "prepublishOnly": "concurrently -c auto -g --timings npm:prepublish:*",
    "prepublish:types": "tsc --declaration true --emitDeclarationOnly true --declarationDir build/types && cp -r build/types/src/main/resources/site dist",
    "prepublish:styles": "mkdir -p dist && cp src/main/resources/assets/styles/blocks/*.css dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "@enonic-types/core": "^7",
    "@enonic-types/global": "^7",
    "@enonic-types/lib-asset": "^1.0.3",
    "@enonic-types/lib-auth": "^7",
    "@enonic-types/lib-common": "^7",
    "@enonic-types/lib-content": "^7",
    "@enonic-types/lib-context": "^7",
    "@enonic-types/lib-event": "^7",
    "@enonic-types/lib-i18n": "^7",
    "@enonic-types/lib-io": "^7",
    "@enonic-types/lib-node": "^7",
    "@enonic-types/lib-portal": "^7",
    "@enonic-types/lib-repo": "^7",
    "@enonic-types/lib-scheduler": "^7",
    "@enonic-types/lib-task": "^7",
    "@enonic-types/lib-value": "^7",
    "@enonic-types/lib-websocket": "^7",
    "@enonic/esbuild-plugin-copy-with-hash": "^0.2.0",
    "@enonic/tsup-plugin-manifest": "^0.0.1",
    "@item-enonic-types/global": "^7.15.0",
    "@item-enonic-types/lib-freemarker": "^3.0.0",
    "@item-enonic-types/lib-http-client": "^3.2.2",
    "@item-enonic-types/lib-menu": "^4.2.1",
    "@item-enonic-types/lib-time": "^1.6.1",
    "@item-enonic-types/lib-turbo-streams": "^1.1.2",
    "@itemconsulting/preset-enonic-xp": "^0.5.0",
    "@itemconsulting/xp-storybook-utils": "^0.3.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/server-webpack5": "^10.4.6",
    "@swc/core": "^1.15.43",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cssnano": "^8.0.2",
    "esbuild-plugin-globals": "^0.2.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "maplibre-gl": "^5.24.0",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.4",
    "q-i": "^2",
    "rimraf": "^6",
    "storybook": "^10.4.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.18.0",
    "@digdir/designsystemet-web": "^1.18.0",
    "@itemconsulting/popover-gallery": "^0.4.0"
  },
  "browserslist": [
    "defaults"
  ]
}
