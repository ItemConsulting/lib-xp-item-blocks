{
  "compilerOptions": {
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "lib": ["dom", "ES2020"],
    "types": ["@itemconsulting/xp-storybook-utils/global"],

    // Stories (and their `.freemarker.ts` deps) import server code via the
    // Enonic absolute-path convention. With `bundler` resolution, paths are
    // resolved relative to this config file (no deprecated baseUrl needed).
    // Mirrors src/main/resources/tsconfig.json so the same imports resolve.
    "paths": {
      "/lib/enonic/asset": ["../node_modules/@enonic-types/lib-asset"],
      "/lib/xp/*": ["../node_modules/@enonic-types/lib-*"],
      "/lib/*": ["../src/main/resources/lib/*", "../node_modules/@item-enonic-types/lib-*"],
      "/site/*": ["../src/main/resources/site/*", "../.xp-codegen/site/*"],
      "/*": ["../src/main/resources/*", "../.xp-codegen/*"]
    }
  },

  // The Storybook config owns type-checking for stories and their Storybook-only
  // helpers, which live under src/ but are browser/Storybook code, not server code.
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "../src/main/resources/**/*.stories.ts",
    "../src/main/resources/site/storybook-utils.ts"
  ],
  "exclude": ["build/*"]
}
